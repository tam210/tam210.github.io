---
import { caseFiles, getCaseById } from "../../data/site";

export function getStaticPaths() {
  return caseFiles.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const caseFile = getCaseById(slug!);

if (!caseFile) {
  return Astro.redirect("/cases/");
}

return Astro.redirect(`/cases/#${caseFile.id}`);
---
