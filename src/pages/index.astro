---
import GlassLayout from "../layouts/GlassLayout.astro";
---

<GlassLayout
  title="Tamara Ossandón — ideas vivas, sistemas inteligentes."
  description="Diseño y construyo SaaS, apps móviles y sistemas en la nube que los equipos usan en el día a día."
  current="inicio"
>
  <section class="glass-hero" aria-labelledby="glass-hero-title">
    <h1 id="glass-hero-title" class="glass-hero__title">
      <span class="glass-hero__line">ideas vivas,</span>
      <span class="glass-hero__line glass-hero__line--accent">sistemas inteligentes.</span>
    </h1>
    <div class="glass-hero__ctas">
      <a href="/cases/" class="glass-btn glass-btn--primary">
        Ver experiencia
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
      <a href="/connect/" class="glass-btn glass-btn--ghost">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        Contacto
      </a>
    </div>
  </section>
</GlassLayout>
