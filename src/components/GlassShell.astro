---
import SceneBackdrop from "./SceneBackdrop.astro";
import GlassHeader from "./GlassHeader.astro";
import type { GlassNavId } from "./GlassHeader.astro";

interface Props {
  current?: GlassNavId;
  /** Softer scene wash for reading pages */
  reading?: boolean;
  /**
   * Scene photo under public/. Omit for home default.
   * Pass `false` for gradient-only (e.g. contacto until bg is ready).
   */
  sceneImage?: string | false;
}

const { current = "inicio", reading = false, sceneImage } = Astro.props;
const waitsForImage = sceneImage !== false;
---

<div
  class:list={[
    "glass-home",
    reading && "glass-home--reading",
    waitsForImage && "glass-home--scene-pending",
  ]}
  data-glass-home
>
  {
    sceneImage === false ? (
      <SceneBackdrop plain />
    ) : sceneImage ? (
      <SceneBackdrop imageSrc={sceneImage} />
    ) : (
      <SceneBackdrop />
    )
  }

  <div class="glass-home__content">
    <GlassHeader current={current} />
    <slot />
  </div>
</div>

<script>
  function waitImage(img: HTMLImageElement) {
    if (img.complete && img.naturalWidth > 0) return Promise.resolve();
    return new Promise<void>((resolve) => {
      img.addEventListener("load", () => resolve(), { once: true });
      img.addEventListener("error", () => resolve(), { once: true });
    });
  }

  function nextFrames(count = 2) {
    return new Promise<void>((resolve) => {
      const step = (left: number) => {
        if (left <= 0) {
          resolve();
          return;
        }
        requestAnimationFrame(() => step(left - 1));
      };
      step(count);
    });
  }

  async function revealGlassScene() {
    const homes = document.querySelectorAll<HTMLElement>("[data-glass-home]");

    for (const home of homes) {
      if (!home.classList.contains("glass-home--scene-pending")) continue;

      const photo = home.querySelector<HTMLImageElement>("[data-scene-photo]");
      const reveal = () => home.classList.remove("glass-home--scene-pending");
      const safety = window.setTimeout(reveal, 2500);

      try {
        const waits: Promise<unknown>[] = [document.fonts.ready];
        if (photo) waits.push(waitImage(photo));
        await Promise.all(waits);

        home.querySelector(".glass-home__content")?.getBoundingClientRect();
        await nextFrames(3);
      } finally {
        window.clearTimeout(safety);
        reveal();
      }
    }
  }

  document.addEventListener("astro:page-load", () => {
    void revealGlassScene();
  });
</script>
