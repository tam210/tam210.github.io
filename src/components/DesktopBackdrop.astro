---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["desktop-backdrop", className]} data-desktop-bg aria-hidden="true">
  <div class="desktop-backdrop__wash"></div>
  <div class="desktop-backdrop__grid"></div>

  <svg class="desktop-backdrop__orbit desktop-backdrop__orbit--1" viewBox="0 0 600 600" fill="none">
    <ellipse cx="300" cy="300" rx="260" ry="120" stroke="url(#orbitGrad1)" stroke-width="1.5" opacity="0.35" />
    <ellipse cx="300" cy="300" rx="260" ry="120" stroke="url(#orbitGrad1)" stroke-width="1" opacity="0.2" transform="rotate(60 300 300)" />
    <ellipse cx="300" cy="300" rx="260" ry="120" stroke="url(#orbitGrad1)" stroke-width="1" opacity="0.15" transform="rotate(120 300 300)" />
    <defs>
      <linearGradient id="orbitGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="rgba(255,255,255,0.9)" />
        <stop offset="50%" stop-color="rgba(143,182,255,0.5)" />
        <stop offset="100%" stop-color="rgba(255,255,255,0.7)" />
      </linearGradient>
    </defs>
  </svg>

  <svg class="desktop-backdrop__orbit desktop-backdrop__orbit--2" viewBox="0 0 500 500" fill="none">
    <ellipse cx="250" cy="250" rx="200" ry="90" stroke="rgba(29,107,255,0.18)" stroke-width="1" />
    <ellipse cx="250" cy="250" rx="200" ry="90" stroke="rgba(255,255,255,0.25)" stroke-width="0.75" transform="rotate(45 250 250)" />
  </svg>

  <div class="desktop-backdrop__orb desktop-backdrop__orb--1"></div>
  <div class="desktop-backdrop__orb desktop-backdrop__orb--2"></div>
  <div class="desktop-backdrop__orb desktop-backdrop__orb--3"></div>
  <div class="desktop-backdrop__bubble desktop-backdrop__bubble--1"></div>
  <div class="desktop-backdrop__bubble desktop-backdrop__bubble--2"></div>
  <div class="desktop-backdrop__bubble desktop-backdrop__bubble--3"></div>

  <svg class="desktop-backdrop__waves" viewBox="0 0 1440 200" preserveAspectRatio="none">
    <path
      d="M0,120 C320,60 520,160 880,100 C1120,60 1280,140 1440,90 L1440,200 L0,200 Z"
      fill="rgba(29,107,255,0.06)"></path>
    <path
      d="M0,150 C280,100 600,180 960,130 C1180,100 1320,160 1440,120 L1440,200 L0,200 Z"
      fill="rgba(255,255,255,0.12)"></path>
  </svg>
</div>

<script>
  const bg = document.querySelector("[data-desktop-bg]");
  if (bg && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    let tx = 0;
    let ty = 0;
    let cx = 0;
    let cy = 0;

    if (fine) {
      bg.closest(".desktop-panel")?.addEventListener(
        "pointermove",
        (e) => {
          const r = bg.getBoundingClientRect();
          tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
          ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
        },
        { passive: true }
      );
    }

    function tick() {
      cx += (tx - cx) * 0.04;
      cy += (ty - cy) * 0.04;
      bg.style.setProperty("--parallax-x", `${cx * 14}px`);
      bg.style.setProperty("--parallax-y", `${cy * 10}px`);
      requestAnimationFrame(tick);
    }
    tick();
  }
</script>
