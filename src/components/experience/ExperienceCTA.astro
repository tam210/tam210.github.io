---
import { experienceTech, techIconSrc } from "../../data/experience";
---

<section class="exp-tech" id="tecnologias" aria-labelledby="exp-tech-title">
  <h2 id="exp-tech-title" class="exp-tech__title">{experienceTech.title}</h2>
  <p class="exp-tech__lead">{experienceTech.lead}</p>

  <div class="exp-tech__production">
    <h3 class="exp-tech__group-label">{experienceTech.productionLabel}</h3>
    <ul class="exp-tech__chips">
      {
        experienceTech.production.map((item) => (
          <li>
            <img
              class="exp-tech__icon"
              src={techIconSrc(item.icon)}
              alt=""
              width="18"
              height="18"
              loading="lazy"
              decoding="async"
            />
            <span>{item.name}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="exp-tech__langs">
    <span class="exp-tech__langs-label">Idiomas:</span>
    {experienceTech.languages}
  </p>
</section>

<footer class="exp-quote" data-exp-quote>
  <blockquote class="exp-quote__text">
    El propósito de la ingeniería de software es controlar la complejidad, no crearla.
  </blockquote>
  <cite class="exp-quote__cite">— Pamela Zave · Científica de la computación</cite>
</footer>
