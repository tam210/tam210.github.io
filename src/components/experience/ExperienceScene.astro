---
import type { ResolvedExperienceScene } from "../../data/experience";
import { resolveTechBadge, techIconSrc } from "../../data/experience";
import ExperienceLayers from "./ExperienceLayers.astro";

interface Props {
  scene: ResolvedExperienceScene;
  index: number;
  showYearAnchor: boolean;
}

const { scene, index, showYearAnchor } = Astro.props;
const { caseFile } = scene;
const stackTags = caseFile.stack.map(resolveTechBadge);
---

<section
  class:list={["exp-scene", scene.compact && "exp-scene--compact"]}
  id={caseFile.id}
  data-exp-scene
  data-year={caseFile.year}
  style={`--scene-i: ${index}`}
>
  {showYearAnchor && <div id={`year-${caseFile.year}`} class="exp-scene__year-anchor" tabindex="-1" />}

  <div class="exp-scene__copy">
    <div class="exp-scene__head">
      {
        caseFile.logo ? (
          <img
            class="exp-scene__logo"
            src={caseFile.logo}
            alt=""
            width="56"
            height="56"
            loading={index < 2 ? "eager" : "lazy"}
          />
        ) : (
          <span class="exp-scene__logo-fallback" aria-hidden="true">
            {caseFile.name.slice(0, 2)}
          </span>
        )
      }
      <div class="exp-scene__titles">
        <div class="exp-scene__name-row">
          <h2 class="exp-scene__name">{caseFile.name}</h2>
          {
            caseFile.companyUrl && (
              <a
                class="exp-scene__explore-icon"
                href={caseFile.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Abrir sitio de ${caseFile.company}`}
                title={caseFile.company}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 17 17 7" />
                  <path d="M8 7h9v9" />
                </svg>
              </a>
            )
          }
        </div>
        <p class="exp-scene__role">{caseFile.role}</p>
        <ul class="exp-scene__stack" aria-label="Stack destacado">
          {
            stackTags.map((tech) => (
              <li class="exp-scene__chip">
                {tech.icon ? (
                  <img
                    class="exp-scene__chip-icon"
                    src={techIconSrc(tech.icon)}
                    alt=""
                    width="14"
                    height="14"
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
                <span>{tech.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="exp-scene__headline">{scene.headline}</p>

    <ExperienceLayers layers={scene.layers} caseFile={caseFile} />
  </div>
</section>
