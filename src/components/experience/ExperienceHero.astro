---
---

<section class="exp-hero" data-exp-hero>
  <div class="exp-hero__glow" aria-hidden="true"></div>
  <div class="exp-hero__topo" aria-hidden="true"></div>
  <div class="exp-hero__particles" aria-hidden="true"></div>

  <div class="exp-hero__inner">
    <p class="exp-hero__eyebrow mono">Recorrido profesional</p>
    <h1 class="exp-hero__title">Experiencia construyendo sistemas reales.</h1>
  </div>

  <div class="exp-river" aria-hidden="true" data-exp-river>
    <svg class="exp-river__svg" viewBox="0 0 120 1800" preserveAspectRatio="none">
      <path
        class="exp-river__path"
        d="M60 0 C40 120 90 220 55 340 C20 460 95 560 60 700 C25 840 100 960 58 1100 C20 1240 95 1360 60 1500 C35 1600 70 1700 60 1800"
        fill="none"
        stroke="url(#riverGrad)"
        stroke-width="3"
        stroke-linecap="round"
      />
      <defs>
        <linearGradient id="riverGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#7dd3fc" stop-opacity="0.2" />
          <stop offset="30%" stop-color="#38bdf8" stop-opacity="0.75" />
          <stop offset="70%" stop-color="#0ea5e9" stop-opacity="0.65" />
          <stop offset="100%" stop-color="#67e8f9" stop-opacity="0.25" />
        </linearGradient>
      </defs>
    </svg>
  </div>
</section>
