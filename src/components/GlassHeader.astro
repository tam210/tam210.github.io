---
export type GlassNavId = "inicio" | "proyectos" | "contacto";

interface Props {
  current?: GlassNavId;
  /** Render brand, rail, or both (default). */
  parts?: "all" | "brand" | "rail";
  /** Brand sits in document flow (e.g. inside a top bar). */
  brandInflow?: boolean;
}

const { current = "inicio", parts = "all", brandInflow = false } = Astro.props;

const showBrand = parts === "all" || parts === "brand";
const showRail = parts === "all" || parts === "rail";

const railNav = [
  { id: "inicio", label: "Inicio", href: "/", icon: "home" },
  { id: "proyectos", label: "Experiencia", href: "/cases/", icon: "cube" },
  { id: "contacto", label: "Contacto", href: "/connect/", icon: "mail" },
] as const;

const brandClass = ["glass-brand", brandInflow && "glass-brand--inflow"];

const social = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/tamara-ossandon/",
    icon: "linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com/tam210/",
    icon: "github",
  },
] as const;
---

{
  showBrand && (
    <div class:list={brandClass}>
      <a href="/" class="glass-brand__home" aria-label="Tamara Ossandón — Inicio">
        <span class="glass-brand__name">Tamara Ossandón</span>
        <span class="glass-brand__role">Software Engineer</span>
      </a>
      <div class="glass-brand__social" aria-label="Redes">
        {social.map((item) => (
          <a
            class="glass-brand__social-link"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.label}
          >
            {item.icon === "linkedin" ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S.02 4.88.02 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V23h-4V8.5zM8.5 8.5h3.84v1.98h.05c.53-1.01 1.84-2.08 3.79-2.08 4.05 0 4.8 2.67 4.8 6.14V23h-4v-5.8c0-1.38-.02-3.16-1.93-3.16-1.93 0-2.22 1.5-2.22 3.06V23h-4V8.5z" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .26.18.59.69.49A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2z" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  )
}

{
  showRail && (
    <nav class="glass-rail glass-surface" aria-label="Principal">
      {railNav.map((item) => (
        <a
          href={item.href}
          class:list={["glass-rail__link", current === item.id && "is-active"]}
          aria-current={current === item.id ? "page" : undefined}
        >
          <span class="glass-rail__icon" aria-hidden="true">
            {item.icon === "home" && (
              <svg viewBox="0 0 24 24">
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5 9.5V20h14V9.5" />
              </svg>
            )}
            {item.icon === "cube" && (
              <svg viewBox="0 0 24 24">
                <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
                <path d="M12 22V12" />
                <path d="m3 7 9 5 9-5" />
              </svg>
            )}
            {item.icon === "mail" && (
              <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            )}
          </span>
          {item.label}
        </a>
      ))}
    </nav>
  )
}
