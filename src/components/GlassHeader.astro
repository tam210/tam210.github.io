---
export type GlassNavId = "inicio" | "proyectos" | "contacto";

interface Props {
  current?: GlassNavId;
}

const { current = "inicio" } = Astro.props;

const railNav = [
  { id: "inicio", label: "Inicio", href: "/", icon: "home" },
  { id: "proyectos", label: "Experiencia", href: "/cases/", icon: "cube" },
  { id: "contacto", label: "Contacto", href: "/connect/", icon: "mail" },
] as const;
---

<nav class="glass-rail glass-surface" aria-label="Principal">
  {
    railNav.map((item) => (
      <a
        href={item.href}
        class:list={["glass-rail__link", current === item.id && "is-active"]}
        aria-current={current === item.id ? "page" : undefined}
      >
        <span class="glass-rail__icon" aria-hidden="true">
          {item.icon === "home" && (
            <svg viewBox="0 0 24 24">
              <path d="M3 10.5 12 3l9 7.5" />
              <path d="M5 9.5V20h14V9.5" />
            </svg>
          )}
          {item.icon === "cube" && (
            <svg viewBox="0 0 24 24">
              <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
              <path d="M12 22V12" />
              <path d="m3 7 9 5 9-5" />
            </svg>
          )}
          {item.icon === "mail" && (
            <svg viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
        </span>
        {item.label}
      </a>
    ))
  }
</nav>
