---
import SceneBackdrop from "./SceneBackdrop.astro";

const topNav = [
  { id: "inicio", label: "Inicio", href: "/", active: true },
  { id: "proyectos", label: "Proyectos", href: "/cases/" },
  { id: "experiencia", label: "Experiencia", href: "/thinking/" },
  { id: "stack", label: "Stack", href: "/systems/" },
  { id: "contacto", label: "Contacto", href: "/connect/" },
];

const railNav = [
  { id: "inicio", label: "Inicio", href: "/", icon: "home", active: true },
  { id: "proyectos", label: "Proyectos", href: "/cases/", icon: "cube" },
  { id: "experiencia", label: "Experiencia", href: "/thinking/", icon: "chart" },
  { id: "stack", label: "Stack", href: "/systems/", icon: "layers" },
  { id: "contacto", label: "Contacto", href: "/connect/", icon: "mail" },
];
---

<div class="glass-home">
  <SceneBackdrop />

  <div class="glass-home__content">
    <header class="glass-header">
      <a href="/" class="glass-logo" aria-label="Inicio">
        <span class="glass-logo__orb" aria-hidden="true">T</span>
      </a>
      <nav class="glass-nav" aria-label="Principal">
        {
          topNav.map((item) => (
            <a
              href={item.href}
              class:list={["glass-nav__link", item.active && "is-active"]}
              aria-current={item.active ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <nav class="glass-rail glass-surface" aria-label="Secciones">
      {
        railNav.map((item) => (
          <a
            href={item.href}
            class:list={["glass-rail__link", item.active && "is-active"]}
            aria-current={item.active ? "page" : undefined}
          >
            <span class="glass-rail__icon" aria-hidden="true">
              {item.icon === "home" && (
                <svg viewBox="0 0 24 24">
                  <path d="M3 10.5 12 3l9 7.5" />
                  <path d="M5 9.5V20h14V9.5" />
                </svg>
              )}
              {item.icon === "cube" && (
                <svg viewBox="0 0 24 24">
                  <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
                  <path d="M12 22V12" />
                  <path d="m3 7 9 5 9-5" />
                </svg>
              )}
              {item.icon === "chart" && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 19V5" />
                  <path d="M4 19h16" />
                  <path d="M8 16v-5" />
                  <path d="M12 16V8" />
                  <path d="M16 16v-3" />
                </svg>
              )}
              {item.icon === "layers" && (
                <svg viewBox="0 0 24 24">
                  <path d="m12 2 9 5-9 5-9-5 9-5Z" />
                  <path d="m3 12 9 5 9-5" />
                  <path d="m3 17 9 5 9-5" />
                </svg>
              )}
              {item.icon === "mail" && (
                <svg viewBox="0 0 24 24">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
            </span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <section class="glass-hero" aria-labelledby="glass-hero-title">
      <h1 id="glass-hero-title" class="glass-hero__title">
        <span class="glass-hero__line">ideas vivas,</span>
        <span class="glass-hero__line glass-hero__line--accent">sistemas inteligentes.</span>
      </h1>
      <div class="glass-hero__ctas">
        <a href="/cases/" class="glass-btn glass-btn--primary">
          Ver proyectos
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </a>
        <a href="/thinking/" class="glass-btn glass-btn--ghost">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8" r="3.5" />
            <path d="M5.5 19.5c1.8-3.2 4-4.8 6.5-4.8s4.7 1.6 6.5 4.8" />
          </svg>
          Mi experiencia
        </a>
      </div>
    </section>
  </div>
</div>
