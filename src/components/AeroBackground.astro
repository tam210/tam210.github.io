---
interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;
---

<div class:list={["aero-bg", `aero-bg--${variant}`]} aria-hidden="true">
  <div class="aero-bg__wash"></div>
  <div class="aero-bg__orb aero-bg__orb--1"></div>
  <div class="aero-bg__orb aero-bg__orb--2"></div>
  <div class="aero-bg__orb aero-bg__orb--3"></div>
  <svg class="aero-bg__waves" viewBox="0 0 1440 320" preserveAspectRatio="none">
    <path
      d="M0,192 C240,128 480,256 720,192 C960,128 1200,224 1440,160 L1440,320 L0,320 Z"
      fill="currentColor"
      opacity="0.06"></path>
    <path
      d="M0,224 C360,160 540,288 900,224 C1080,192 1260,256 1440,208 L1440,320 L0,320 Z"
      fill="currentColor"
      opacity="0.04"></path>
  </svg>
</div>

<style>
  .aero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .aero-bg--light {
    color: var(--os-xp-blue);
  }

  .aero-bg--dark {
    color: var(--os-blue-soft);
  }

  .aero-bg__wash {
    position: absolute;
    inset: 0;
  }

  .aero-bg--light .aero-bg__wash {
    background:
      radial-gradient(ellipse 55% 45% at 15% 20%, rgba(255, 255, 255, 0.7) 0%, transparent 55%),
      radial-gradient(ellipse 50% 40% at 85% 75%, rgba(143, 182, 255, 0.2) 0%, transparent 50%),
      radial-gradient(ellipse 80% 60% at 50% 100%, rgba(29, 107, 255, 0.08) 0%, transparent 55%);
  }

  .aero-bg--dark .aero-bg__wash {
    background:
      radial-gradient(ellipse 45% 35% at 10% 15%, rgba(29, 107, 255, 0.12) 0%, transparent 55%),
      radial-gradient(ellipse 40% 30% at 90% 80%, rgba(143, 182, 255, 0.06) 0%, transparent 50%);
  }

  .aero-bg__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.5;
    animation: orbDrift 18s ease-in-out infinite;
  }

  .aero-bg__orb--1 {
    width: clamp(120px, 18vw, 220px);
    height: clamp(120px, 18vw, 220px);
    top: 12%;
    right: 8%;
    background: rgba(255, 255, 255, 0.45);
  }

  .aero-bg--dark .aero-bg__orb--1 {
    background: rgba(29, 107, 255, 0.15);
    opacity: 0.7;
  }

  .aero-bg__orb--2 {
    width: clamp(80px, 12vw, 140px);
    height: clamp(80px, 12vw, 140px);
    bottom: 18%;
    left: 6%;
    background: rgba(143, 182, 255, 0.35);
    animation-delay: -6s;
  }

  .aero-bg--dark .aero-bg__orb--2 {
    background: rgba(100, 150, 255, 0.1);
  }

  .aero-bg__orb--3 {
    width: 60px;
    height: 60px;
    top: 40%;
    left: 45%;
    background: rgba(255, 255, 255, 0.55);
    filter: blur(24px);
    animation-delay: -12s;
  }

  .aero-bg--dark .aero-bg__orb--3 {
    display: none;
  }

  .aero-bg__waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: auto;
    min-height: 120px;
    opacity: 0.9;
  }

  @keyframes orbDrift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(8px, -12px) scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aero-bg__orb {
      animation: none;
    }
  }
</style>
