---
import OsWindow from "../OsWindow.astro";
import AeroBackground from "../AeroBackground.astro";
---

<section id="contact" class="os-section os-section--dark contact-section">
  <AeroBackground variant="dark" />
  <span class="os-section-num" aria-hidden="true">05</span>
  <div class="os-container contact-section__inner">
    <OsWindow title="connect.exe" dark interactive={false} class="contact-section__window">
      <h2 class="contact-section__title display">¿Tienes un proyecto, una idea o una oportunidad?</h2>
      <p class="contact-section__lead">Hablemos.</p>

      <ul class="contact-section__links">
        <li>
          <span class="mono contact-section__label">email</span>
          <a href="mailto:ossandon.t20@gmail.com">ossandon.t20@gmail.com</a>
          <button type="button" class="os-btn os-btn--ghost-dark contact-section__copy mono" data-copy="ossandon.t20@gmail.com">
            copiar
          </button>
        </li>
        <li>
          <span class="mono contact-section__label">linkedin</span>
          <a href="https://www.linkedin.com/in/tamara-ossandon/" target="_blank" rel="noopener noreferrer">
            /in/tamara-ossandon
          </a>
        </li>
        <li>
          <span class="mono contact-section__label">github</span>
          <a href="https://github.com/tam210/" target="_blank" rel="noopener noreferrer">tam210</a>
        </li>
      </ul>

      <a href="mailto:ossandon.t20@gmail.com?subject=Hola%20Tamara" class="os-btn os-btn--primary contact-section__cta">
        Hablemos
      </a>

      <p class="os-window__status mono">&gt; ONLINE</p>
    </OsWindow>

    <div class="os-retro-cursor contact-section__cursor" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M4 3l14 9.5-5.5 1.5L10 20 4 3z" fill="#fff" stroke="#0a1020" stroke-width="1.2"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .contact-section {
    overflow: hidden;
  }

  .contact-section__inner {
    position: relative;
    z-index: 1;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .contact-section__window {
    width: min(100%, 480px);
    position: relative;
    z-index: 1;
  }

  .contact-section__title {
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 0.5rem;
    color: var(--os-text-on-dark);
  }

  .contact-section__lead {
    font-size: 1.05rem;
    color: var(--os-text-muted-dark);
    margin: 0 0 1.5rem;
  }

  .contact-section__links {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-section__links li {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 0.5rem 1rem;
    align-items: center;
  }

  .contact-section__label {
    font-size: 0.68rem;
    text-transform: lowercase;
    color: var(--os-text-muted-dark);
  }

  .contact-section__links a {
    color: var(--os-blue-soft);
    font-size: 0.9rem;
  }

  .contact-section__copy {
    padding: 0.35rem 0.65rem;
    font-size: 0.65rem;
  }

  .contact-section__cta {
    width: 100%;
  }

  .contact-section__cursor {
    right: 10%;
    bottom: 15%;
  }

  @media (max-width: 640px) {
    .contact-section__links li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .contact-section__copy {
      justify-self: start;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "copiado ✓";
        setTimeout(() => {
          btn.textContent = "copiar";
        }, 2000);
      } catch {
        btn.textContent = text;
      }
    });
  });
</script>
