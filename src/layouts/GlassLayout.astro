---
import BaseLayout from "./BaseLayout.astro";
import GlassShell from "../components/GlassShell.astro";

import type { GlassNavId } from "../components/GlassHeader.astro";

interface Props {
  title?: string;
  description?: string;
  current?: GlassNavId;
  reading?: boolean;
  /** Scene photo path, or `false` for gradient-only */
  sceneImage?: string | false;
}

const DEFAULT_SCENE = "/images/background_green.webp";

const {
  title,
  description,
  current = "inicio",
  reading = false,
  sceneImage,
} = Astro.props;

const preloadImage = sceneImage === false ? undefined : (sceneImage ?? DEFAULT_SCENE);
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="glass-body"
  themeColor="#d6e4ff"
  preloadImage={preloadImage}
>
  <main id="main">
    <GlassShell current={current} reading={reading} sceneImage={sceneImage}>
      <slot />
    </GlassShell>
  </main>
</BaseLayout>
