---
import { ClientRouter } from "astro:transitions";
import { pageLayer } from "../lib/pageTransition";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  themeColor?: string;
  /** High-priority background/scene image */
  preloadImage?: string;
}

const {
  title = "Tamara Ossandón — Full-stack Developer",
  description = "Construyo software para problemas reales. Full-stack · Web · Móvil · GCP.",
  bodyClass = "os-body os-body--dark",
  themeColor = "#07101f",
  preloadImage,
} = Astro.props;
---

<!doctype html>
<html
  lang="es"
  class={
    bodyClass.includes("glass-body")
      ? "os-html--glass"
      : bodyClass.includes("os-body--light")
        ? "os-html--light"
        : "os-html--dark"
  }
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />
    <meta name="author" content="Tamara Ossandón" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://tam210.github.io" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <link rel="canonical" href="https://tam210.github.io" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class={bodyClass} transition:animate={pageLayer}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div
      id="route-loader"
      class="route-loader"
      transition:persist="route-loader"
      role="status"
      aria-live="polite"
      aria-busy="false"
      aria-hidden="true"
    >
      <div class="route-loader__mark" aria-hidden="true">
        <div class="route-loader__spinner"></div>
      </div>
      <span class="route-loader__label">Cargando…</span>
    </div>
    <slot />
    <script is:inline>
      (() => {
        if (window.__routeLoaderBound) return;
        window.__routeLoaderBound = true;

        const DELAY_MS = 280;
        let timer = 0;
        let observer = null;

        const el = () => document.getElementById("route-loader");

        const scenePending = () =>
          Boolean(
            document.querySelector(".glass-home--scene-pending") ||
              document.body.classList.contains("exp-body--scene-pending")
          );

        const setBusy = (busy) => {
          const node = el();
          if (!node) return;
          node.classList.toggle("is-visible", busy);
          node.setAttribute("aria-busy", busy ? "true" : "false");
          node.setAttribute("aria-hidden", busy ? "false" : "true");
        };

        const stopWatch = () => {
          if (observer) {
            observer.disconnect();
            observer = null;
          }
        };

        const clearArm = () => {
          window.clearTimeout(timer);
          timer = 0;
        };

        const watchScene = () => {
          stopWatch();
          clearArm();
          setBusy(false);

          if (!scenePending()) return;

          observer = new MutationObserver(() => {
            if (!scenePending()) {
              stopWatch();
              clearArm();
              setBusy(false);
            }
          });
          observer.observe(document.body, {
            attributes: true,
            subtree: true,
            attributeFilter: ["class"],
          });

          timer = window.setTimeout(() => {
            if (scenePending()) setBusy(true);
          }, DELAY_MS);
        };

        const arm = () => {
          clearArm();
          timer = window.setTimeout(() => setBusy(true), DELAY_MS);
        };

        document.addEventListener("astro:before-preparation", arm);
        document.addEventListener("astro:after-swap", watchScene);
        document.addEventListener("astro:page-load", watchScene);
        watchScene();
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/page-transitions.css";
  @import "../styles/global.css";
</style>
