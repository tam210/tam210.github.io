---
import { ClientRouter } from "astro:transitions";
import { pageLayer } from "../lib/pageTransition";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Experiencia — Tamara Ossandón",
  description = "Productos, plataformas y automatizaciones diseñadas para operar fuera del prototipo.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="exp-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e8f4ff" />
    <meta name="description" content={description} />
    <meta name="author" content="Tamara Ossandón" />
    <link rel="canonical" href="https://tam210.github.io/cases/" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="exp-body" transition:animate={pageLayer}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div
      id="route-loader"
      class="route-loader"
      transition:persist="route-loader"
      role="status"
      aria-live="polite"
      aria-hidden="true"
    >
      <div class="route-loader__spinner" aria-hidden="true"></div>
      <span class="route-loader__label">Cargando…</span>
    </div>
    <slot />
    <script is:inline>
      (() => {
        if (window.__routeLoaderBound) return;
        window.__routeLoaderBound = true;

        const DELAY_MS = 160;
        let timer = 0;

        const el = () => document.getElementById("route-loader");

        const show = () => {
          const node = el();
          if (!node) return;
          node.classList.add("is-visible");
          node.setAttribute("aria-hidden", "false");
        };

        const hide = () => {
          window.clearTimeout(timer);
          timer = 0;
          const node = el();
          if (!node) return;
          node.classList.remove("is-visible");
          node.setAttribute("aria-hidden", "true");
        };

        const arm = () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(show, DELAY_MS);
        };

        document.addEventListener("astro:before-preparation", arm);
        document.addEventListener("astro:page-load", hide);
        document.addEventListener("astro:after-swap", hide);
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/page-transitions.css";
  @import "../styles/glass-chrome.css";
  @import "../styles/experience.css";
</style>
